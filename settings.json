{
  "alwaysThinkingEnabled" : true,
  "autoDreamEnabled" : true,
  "enabledPlugins" : {
    "andrej-karpathy-skills@karpathy-skills" : true,
    "claude-code-setup@claude-plugins-official" : true,
    "claude-md-management@claude-plugins-official" : true,
    "code-review@claude-plugins-official" : true,
    "code-simplifier@claude-plugins-official" : true,
    "codex@openai-codex" : true,
    "commit-commands@claude-plugins-official" : true
  },
  "env" : {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS" : "128000"
  },
  "extraKnownMarketplaces" : {
    "karpathy-skills" : {
      "source" : {
        "repo" : "forrestchang\/andrej-karpathy-skills",
        "source" : "github"
      }
    },
    "openai-codex" : {
      "source" : {
        "repo" : "openai\/codex-plugin-cc",
        "source" : "github"
      }
    }
  },
  "hooks" : {
    "Notification" : [
      {
        "hooks" : [
          {
            "command" : "test -x \"$HOME\/.claude\/hooks\/notify.sh\" && \"$HOME\/.claude\/hooks\/notify.sh\" idle_prompt || true",
            "type" : "command"
          }
        ],
        "matcher" : "idle_prompt"
      },
      {
        "hooks" : [
          {
            "command" : "test -x \"$HOME\/.claude\/hooks\/notify.sh\" && \"$HOME\/.claude\/hooks\/notify.sh\" elicitation_dialog || true",
            "type" : "command"
          }
        ],
        "matcher" : "elicitation_dialog"
      },
      {
        "hooks" : [
          {
            "command" : "test -x \"$HOME\/.claude\/hooks\/notify.sh\" && \"$HOME\/.claude\/hooks\/notify.sh\" auth_success || true",
            "type" : "command"
          }
        ],
        "matcher" : "auth_success"
      },
      {
        "hooks" : [
          {
            "command" : "$HOME\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "test -x \"$HOME\/.claude\/hooks\/notify.sh\" && \"$HOME\/.claude\/hooks\/notify.sh\" permission_prompt || true",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      },
      {
        "hooks" : [
          {
            "command" : "$HOME\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "$HOME\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "$HOME\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "$HOME\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "$HOME\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "test -x \"$HOME\/.claude\/hooks\/notify.sh\" && \"$HOME\/.claude\/hooks\/notify.sh\" stop || true",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "$HOME\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "StopFailure" : [
      {
        "hooks" : [
          {
            "command" : "$HOME\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "$HOME\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ]
  },
  "model" : "claude-fable-5[1m]",
  "permissions" : {
    "allow" : [
      "Bash",
      "WebSearch",
      "WebFetch",
      "mcp__github__issue_write",
      "mcp__github__get_me",
      "Skill(commit-commands:commit)",
      "mcp__plugin_vercel_vercel__list_teams",
      "mcp__plugin_vercel_vercel__list_projects",
      "mcp__plugin_vercel_vercel__get_runtime_logs",
      "mcp__plugin_vercel_vercel__get_deployment",
      "mcp__plugin_vercel_vercel__get_deployment_build_logs",
      "mcp__plugin_vercel_vercel__web_fetch_vercel_url",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_click",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_resize",
      "mcp__plugin_playwright_playwright__browser_close",
      "mcp__plugin_playwright_playwright__browser_evaluate",
      "mcp__plugin_playwright_playwright__browser_run_code",
      "mcp__plugin_playwright_playwright__browser_hover",
      "mcp__plugin_playwright_playwright__browser_wait_for"
    ],
    "ask" : [
      "Skill(plugin-skill-name)",
      "Skill(plugin-skill-prefix:*)"
    ],
    "defaultMode" : "auto",
    "deny" : [

    ]
  },
  "skipAutoPermissionPrompt" : true,
  "statusLine" : {
    "command" : "input=$(cat); user=$(whoami); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir' | sed \"s|$HOME|~|g\"); model=$(echo \"$input\" | jq -r '.model.display_name'); time=$(date +%H:%M); remaining=$(echo \"$input\" | jq -r '.context_window.remaining_percentage \/\/ empty'); transcript=$(echo \"$input\" | jq -r '.transcript_path'); todo_count=$([ -f \"$transcript\" ] && grep -c '\"type\":\"todo\"' \"$transcript\" 2>\/dev\/null || echo 0); cost=$(echo \"$input\" | jq -r '.cost.total_cost_usd \/\/ empty'); lines_added=$(echo \"$input\" | jq -r '.cost.total_lines_added \/\/ empty'); lines_removed=$(echo \"$input\" | jq -r '.cost.total_lines_removed \/\/ empty'); duration_ms=$(echo \"$input\" | jq -r '.cost.total_duration_ms \/\/ empty'); cd \"$(echo \"$input\" | jq -r '.workspace.current_dir')\" 2>\/dev\/null; branch=$(git --no-optional-locks rev-parse --abbrev-ref HEAD 2>\/dev\/null || echo ''); status=''; [ -n \"$branch\" ] && { [ -n \"$(git --no-optional-locks status --porcelain 2>\/dev\/null)\" ] && status='*'; }; B='\\033[38;2;30;102;245m'; G='\\033[38;2;64;160;43m'; Y='\\033[38;2;223;142;29m'; M='\\033[38;2;136;57;239m'; C='\\033[38;2;23;146;153m'; R='\\033[0m'; T='\\033[38;2;76;79;105m'; Rd='\\033[38;2;210;77;77m'; printf \"${C}${user}${R}:${B}${cwd}${R}\"; [ -n \"$branch\" ] && printf \" ${G}${branch}${Y}${status}${R}\"; [ -n \"$remaining\" ] && printf \" ${M}ctx:${remaining}%%${R}\"; printf \" ${T}${model}${R} ${Y}${time}${R}\"; [ -n \"$cost\" ] && printf \" ${C}\\$%.2f${R}\" \"$cost\"; { [ -n \"$lines_added\" ] || [ -n \"$lines_removed\" ]; } && { la=${lines_added:-0}; lr=${lines_removed:-0}; printf \" ${G}+${la}${R}\/${Rd}-${lr}${R}\"; }; [ -n \"$duration_ms\" ] && { ds=$((duration_ms \/ 1000)); dm=$((ds \/ 60)); dh=$((dm \/ 60)); if [ \"$dh\" -gt 0 ]; then drm=$((dm % 60)); printf \" ${T}${dh}h${drm}m${R}\"; else printf \" ${T}${dm}m${R}\"; fi; }; [ \"$todo_count\" -gt 0 ] && printf \" ${C}todos:${todo_count}${R}\"; echo",
    "type" : "command"
  },
  "tui" : "fullscreen",
  "worktree" : {
    "bgIsolation" : "none"
  }
}